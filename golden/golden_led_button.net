(export (version "E")
  (design
    (source "golden_led_button")
    (tool "circuitgen (0.1.0)"))
  (components
    (comp (ref "#FLG01")
      (value "PWR_FLAG")
      (libsource (lib "power") (part "PWR_FLAG"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "868cdfab-04c8-51c1-b8a1-e4161ba88cdb"))
    (comp (ref "#FLG02")
      (value "PWR_FLAG")
      (libsource (lib "power") (part "PWR_FLAG"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "56fc8674-c09a-530b-9f95-7dc675237e93"))
    (comp (ref "#PWR01")
      (value "+5V")
      (libsource (lib "power") (part "+5V"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "f9713455-f3f8-5510-9cc5-77ba6a8bfa23"))
    (comp (ref "#PWR02")
      (value "GND")
      (libsource (lib "power") (part "GND"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "c5f7f579-340f-5512-8009-b71f4afc535e"))
    (comp (ref "D1")
      (value "LED")
      (footprint "LED_SMD:LED_0805_2012Metric")
      (libsource (lib "Device") (part "LED"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "897ad9e5-6283-5357-aadd-cdeec2073955"))
    (comp (ref "R1")
      (value "330R")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (libsource (lib "Device") (part "R"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "546df582-267d-5023-91d9-0c91454a5d1e"))
    (comp (ref "SW1")
      (value "SW_Push")
      (footprint "Button_Switch_SMD:SW_SPST_PTS645")
      (libsource (lib "Switch") (part "SW_Push"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "3f8cc44a-a6d9-5e87-94ba-ca7a0584f51c"))
  )
  (nets
    (net (code "1") (name "+5V")
      (node (ref "#FLG01") (pin "1") (pintype "power_out"))
      (node (ref "#PWR01") (pin "1") (pintype "power_in"))
      (node (ref "SW1") (pin "1") (pintype "passive"))
    )
    (net (code "2") (name "GND")
      (node (ref "#FLG02") (pin "1") (pintype "power_out"))
      (node (ref "#PWR02") (pin "1") (pintype "power_in"))
      (node (ref "D1") (pin "1") (pintype "passive"))
    )
    (net (code "3") (name "R_LED")
      (node (ref "D1") (pin "2") (pintype "passive"))
      (node (ref "R1") (pin "2") (pintype "passive"))
    )
    (net (code "4") (name "SW_R")
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "SW1") (pin "2") (pintype "passive"))
    )
  )
)
