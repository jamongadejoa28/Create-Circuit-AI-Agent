{
  "id": "i2c_temperature_sensor",
  "function": "Connects an I2C temperature sensor to a verified MCU pin pair with one pull-up per bus line and local sensor decoupling",
  "apply_when": [
    "i2c temperature",
    "i2c sensor",
    "i2c 온도",
    "i2c 센서"
  ],
  "provides": [
    "i2c",
    "temperature_sensor"
  ],
  "roles": {
    "MCU": {
      "kind": "microcontroller",
      "lib_id": "MCU_ST_STM32G4:STM32G474RETx",
      "allow_unbound_pins": true,
      "pins": {
        "SDA": {
          "names": [
            "PB9"
          ]
        },
        "SCL": {
          "names": [
            "PA15"
          ]
        }
      }
    },
    "SENSOR": {
      "kind": "sensor",
      "lib_id": "Sensor_Temperature:Si7050-A20",
      "pins": {
        "SDA": {
          "names": [
            "SDA"
          ]
        },
        "SCL": {
          "names": [
            "SCL"
          ]
        },
        "VDD": {
          "names": [
            "VDD"
          ]
        },
        "GND": {
          "names": [
            "GND"
          ]
        }
      }
    },
    "R_SDA": {
      "kind": "resistor",
      "lib_id": "Device:R",
      "param": "Rpullup",
      "default_value": "10k"
    },
    "R_SCL": {
      "kind": "resistor",
      "lib_id": "Device:R",
      "param": "Rpullup",
      "default_value": "10k"
    },
    "C_SENSOR": {
      "kind": "capacitor",
      "lib_id": "Device:C",
      "param": "Cdecouple",
      "default_value": "100nF"
    }
  },
  "ports": [
    "VCC",
    "GND"
  ],
  "rail_ports": {
    "VCC": "lowest_supply"
  },
  "topology": [
    [
      "MCU.SDA",
      "SENSOR.SDA"
    ],
    [
      "SENSOR.SDA",
      "R_SDA.1"
    ],
    [
      "R_SDA.2",
      "VCC"
    ],
    [
      "MCU.SCL",
      "SENSOR.SCL"
    ],
    [
      "SENSOR.SCL",
      "R_SCL.1"
    ],
    [
      "R_SCL.2",
      "VCC"
    ],
    [
      "SENSOR.VDD",
      "VCC"
    ],
    [
      "C_SENSOR.1",
      "VCC"
    ],
    [
      "SENSOR.GND",
      "GND"
    ],
    [
      "C_SENSOR.2",
      "GND"
    ]
  ],
  "params": {
    "Rpullup": "10k for the verified standard-mode short bus; reduce according to bus capacitance and sink-current limits",
    "Cdecouple": "100nF local bypass at the sensor supply pins"
  },
  "required_wired": [
    [
      "MCU.SDA",
      "SENSOR.SDA"
    ],
    [
      "SENSOR.SDA",
      "R_SDA.1"
    ],
    [
      "MCU.SCL",
      "SENSOR.SCL"
    ],
    [
      "SENSOR.SCL",
      "R_SCL.1"
    ]
  ],
  "placement": {
    "inputs": [
      "MCU"
    ],
    "outputs": [
      "SENSOR"
    ]
  },
