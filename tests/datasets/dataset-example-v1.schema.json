{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitgen.local/schemas/dataset-example-v1.schema.json",
  "title": "CircuitGen DatasetExample v1",
  "type": "object",
  "required": ["schema_version", "id", "split", "provenance", "input", "requirements", "expected", "validation"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "dataset-example-v1"},
    "id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "provenance": {
      "type": "object",
      "required": ["dataset", "source_project", "license", "source_revision", "extraction_tool", "kicad_version"],
      "additionalProperties": false,
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "source_project": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "split_group": {"type": "string", "minLength": 1},
        "extraction_tool": {"type": "string", "minLength": 1},
        "kicad_version": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "required": ["prompt", "mode"],
      "additionalProperties": false,
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "mode": {"enum": ["transcription", "design"]}
      }
    },
    "requirements": {"type": "object"},
    "expected": {
      "type": "object",
      "required": ["canonical_ir", "physical_bindings", "design_rules", "relative_placement_constraints"],
      "properties": {
        "canonical_ir": {"type": ["object", "null"]},
        "physical_bindings": {"type": "array"},
        "design_rules": {"type": "array"},
        "relative_placement_constraints": {"type": "array"},
        "external_representation": {"type": "object"}
      }
    },
    "validation": {
      "type": "object",
      "required": ["review_status", "parse_ok", "symbol_binding_ok", "netlist_round_trip_ok", "render_ok", "known_issues"],
      "additionalProperties": true,
      "properties": {
        "review_status": {"enum": ["candidate", "accepted", "rejected"]},
        "parse_ok": {"type": "boolean"},
        "symbol_binding_ok": {"type": "boolean"},
        "netlist_round_trip_ok": {"type": "boolean"},
        "render_ok": {"type": "boolean"},
        "known_issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
